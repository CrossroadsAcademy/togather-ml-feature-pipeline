# PyFlink Session Feature Job Dockerfile

FROM flink:1.19-java11

# Install Python, pip, and JDK for pemja build
USER root
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    openjdk-11-jdk-headless \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set Java home for pemja build
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-arm64
# Fallback for x86
RUN if [ ! -d "$JAVA_HOME" ]; then \
    export JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64; \
    fi

# Download Kafka connector JARs (required for KafkaSource)
# These must be in the Flink lib directory
RUN curl -L -o /opt/flink/lib/flink-connector-kafka-3.2.0-1.19.jar \
    https://repo1.maven.org/maven2/org/apache/flink/flink-connector-kafka/3.2.0-1.19/flink-connector-kafka-3.2.0-1.19.jar && \
    curl -L -o /opt/flink/lib/kafka-clients-3.6.1.jar \
    https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/3.6.1/kafka-clients-3.6.1.jar

# Install S3 filesystem plugin for checkpoint storage
# The plugin must be in the plugins directory
RUN mkdir -p /opt/flink/plugins/s3-fs-hadoop && \
    curl -L -o /opt/flink/plugins/s3-fs-hadoop/flink-s3-fs-hadoop-1.19.1.jar \
    https://repo1.maven.org/maven2/org/apache/flink/flink-s3-fs-hadoop/1.19.1/flink-s3-fs-hadoop-1.19.1.jar

# Set Python3 as default
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Install Python dependencies in two stages for better caching
# Stage 1: Heavy dependencies that rarely change (cached)
RUN pip3 install --no-cache-dir \
    apache-flink==1.19.0 \
    numpy'<2.0.0' \
    redis'>=5.0.0' \
    minio'>=7.2.0' \
    pydantic'>=2.5.0' \
    pydantic-settings'>=2.1.0' \
    python-dotenv'>=1.0.0' \
    structlog'>=23.2.0' \
    prometheus-client'>=0.19.0' \
    'pyarrow>=5.0.0,<15.0.0' \
    'tenacity>=8.2.3'

# Stage 2: Event SDK from test.pypi (may change more often)
# TODO: Remove --extra-index-url once SDK is on main PyPI
RUN pip3 install --no-cache-dir --extra-index-url https://test.pypi.org/simple/ \
    togather-event-sdk==2.0.3

# Copy application code
WORKDIR /opt/flink/app
COPY src/flink /opt/flink/app/src/flink
COPY src/streaming /opt/flink/app/src/streaming
COPY src/utils /opt/flink/app/src/utils

# Create empty __init__.py files to make packages importable
RUN touch /opt/flink/app/src/__init__.py

# Set PYTHONPATH
ENV PYTHONPATH=/opt/flink/app

# Ensure flink user owns everything and can write to temp
RUN chown -R flink:flink /opt/flink && \
    chmod -R 755 /opt/flink/lib

# Switch back to flink user
USER flink

# Default command
CMD ["help"]
