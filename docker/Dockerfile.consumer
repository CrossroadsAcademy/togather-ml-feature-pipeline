# AppEventsProcessor Consumer Dockerfile
#
# Python Kafka consumer that archives raw events to MinIO (Hive partitioned Parquet)
#
# Build:
#   docker build -t togather-ml/app-events-processor:v1 -f docker/Dockerfile.consumer .
#
# Push to registry:
#   docker push your-registry/app-events-processor:v1

FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Install Python dependencies
# Core dependencies
# NOTE: numpy<2.0.0 required for pyarrow compatibility
RUN pip install --no-cache-dir \
    'requests>=2.31.0' \
    'numpy<2.0.0' \
    'confluent-kafka>=2.3.0' \
    'redis>=5.0.0' \
    'minio>=7.2.0' \
    'pydantic>=2.5.0' \
    'pydantic-settings>=2.1.0' \
    'python-dotenv>=1.0.0' \
    'structlog>=23.2.0' \
    'prometheus-client>=0.19.0' \
    'pyarrow>=5.0.0,<15.0.0' \
    'tenacity>=8.2.3' \
    'httpx>=0.27.0'

# Install Event SDK from test.pypi
# TODO: Remove --extra-index-url once SDK is on main PyPI
RUN pip install --no-cache-dir --extra-index-url https://test.pypi.org/simple/ \
    togather-event-sdk==2.0.0

# Copy application code
COPY src/streaming /app/src/streaming
COPY src/utils /app/src/utils

# Create empty __init__.py files to make packages importable
RUN touch /app/src/__init__.py

# Set PYTHONPATH and ensure unbuffered output for logs
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Expose Prometheus metrics port
EXPOSE 8080

# Default entrypoint runs the consumer
CMD ["python", "-m", "src.streaming.run_consumer"]
